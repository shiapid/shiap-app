# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local staging validation receipt used by the explicit production promotion gate.
/deployment/staging/last-validated.json

.env*

# Environment variables
.env*
!.env.example

# Private local verification artifacts
/tmp/

# Generated Fast Release archives remain private, outside Git
/deployment/cpanel/SHIAP-*-RELEASE*.zip
